server {
    listen 443 ssl;
    listen [::]:443 ssl;

    access_log /var/log/nginx/webcam-access.log;
    error_log /var/log/nginx/webcam-error.log;

    ssl_certificate     {{ printer_data }}/certs/moonraker.cert;
    ssl_certificate_key {{ printer_data }}/certs/moonraker.key;

    server_name _;

    location /webcam/ {
        postpone_output 0;
        proxy_buffering off;
        proxy_ignore_headers X-Accel-Buffering;
        access_log off;
        error_log off;
        proxy_pass http://127.0.0.1:{{ webcam_port }}/;
    }
}
