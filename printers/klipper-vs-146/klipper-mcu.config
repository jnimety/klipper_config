# Klipper `make menuconfig` selections for klipper-vs-146's main MCU
# (SKR Mini E3 v2.0, STM32F103). Copy to ~/klipper/.config, then
# `make olddefconfig && make`. See README.md "Upgrading Klipper
# firmware" for the full procedure — this board does not support
# `make flash`; use scripts/flash-sdcard.sh instead.
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32F103=y
CONFIG_STM32_FLASH_START_7000=y
CONFIG_STM32_CLOCK_REF_8M=y
CONFIG_STM32_USB_PA11_PA12=y
CONFIG_INITIAL_PINS="!PA14"
